# Stripe webhook signing secret from https://dashboard.stripe.com/webhooks
# (starts with "whsec_"). REQUIRED for live paid plans — webhook events are
# rejected without it.
STRIPE_WEBHOOK_SECRET=REDACTED
# RevenueCat webhook authorization. Paste the EXACT value you type into
# RevenueCat Dashboard → Project → Integrations → Webhooks → Authorization
# header. REQUIRED for live subscription upgrades — events are dropped
# without it, and no user ever gets upgraded to Pro.
REVENUECAT_WEBHOOK_SECRET=REDACTED
# "production" | "preview" | "development". Flipping to "production"
# disables /docs & /redoc and switches CORS to the strict allowlist below.
APP_ENV=preview
# Comma-separated list of origins allowed to call the API from a browser.
# Mobile apps don't need this; the web preview + Emergent custom domain do.
CORS_ORIGINS=
# Public backend URL used by Stripe webhook_url. Leave blank to derive from
# the inbound request host (fine when the backend is behind an https ingress).
BACKEND_PUBLIC_URL=
PERPLEXITY_API_KEY=REDACTED
ELEVENLABS_API_KEY=REDACTED
